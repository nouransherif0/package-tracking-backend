          "name": "Feature 7 - Courier Accept Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Ensure deliverOrderId is assigned to courier (id 2) by admin before accepting",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"baseUrlOrder\") + \"/admin/\" + pm.collectionVariables.get(\"deliverOrderId\") + \"/assign\",",
                  "    method: \"PUT\",",
                  "    header: {",
                  "        \"Content-Type\": \"application/json\",",
                  "        \"Authorization\": \"Bearer \" + pm.collectionVariables.get(\"adminToken\")",
                  "    },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({ courierid: 2 })",
                  "    }",
                  "}, function (err, res) {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.expect(data.order.status).to.eql(\"Accepted\");"

        {
          "name": "Feature 9 - Admin Delete Order",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Create a fresh order for admin to safely delete without affecting other flows",
                  "pm.sendRequest({",
                  "    url: pm.collectionVariables.get(\"baseUrlOrder\"),",
                  "    method: \"POST\",",
                  "    header: {",
                  "        \"Content-Type\": \"application/json\",",
                  "        \"Authorization\": \"Bearer \" + pm.collectionVariables.get(\"userToken\")",
                  "    },",
                  "    body: {",
                  "        mode: \"raw\",",
                  "        raw: JSON.stringify({",
                  "            pickup: \"Temp Pickup\",",
                  "            dropoff: \"Temp Dropoff\",",
                  "            details: \"Order to be deleted by Admin\",",
                  "            deliverytime: \"2028-12-31T18:00\"",
                  "        })",
                  "    }",
                  "}, function (err, res) {",
                  "    if (!err && res.json() && res.json().order) {",
                  "        pm.collectionVariables.set(\"adminDeleteId\", res.json().order.id);",
                  "    }",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.expect(data.message).to.eql(\"order deleted\");"
                ]
              }
            }
          ],
